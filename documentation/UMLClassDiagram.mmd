classDiagram

class User {
    +int UserId
    +int RoleId
    +string Username
    +string Email
    +string PasswordHash
    +bool IsActive
    +int FailedLoginCount
    +DateTime? LockoutEnd
    +bool MustChangePassword
    +DateTime CreatedAt
    +DateTime? LastLoginAt
}

class Role {
    +int RoleId
    +string Name
}

class UserSession {
    +string SessionKeyHash
    +int UserId
    +byte[] Ticket
    +DateTime CreatedAt
    +DateTime ExpiresAt
}

Role "1" --> "*" User
User "1" --> "*" UserSession

class Category {
    +int CategoryId
    +string Name
    +bool IsVisible
}

class Product {
    +int ProductId
    +int CategoryId
    +string Name
    +string? Description
    +decimal? Price
    +bool IsPriceVisible
    +bool IsActive
}

Category "1" --> "*" Product

class Event {
    +int EventId
    +string Name
    +string? Description
    +string Location
    +DateTime StartDateTime
    +DateTime? EndDateTime
}

%% One image model for all owners: exactly one of ProductId / EventId is set (CK_Images_ExactlyOneOwner).
%% EventId comes with the events (#14).
class Image {
    +int ImageId
    +int? ProductId
    +int? EventId
    +string FileName
    +string? Description
    +string ContentType
    +long Length
    +int SortOrder
    +bool IsPrimary
}

class ImageContent {
    +int ImageId
    +byte[] Data
}

Product "1" --> "*" Image
Event "1" --> "*" Image
Image "1" --> "1" ImageContent

class ContactRequest {
    +int ContactRequestId
    +string FirstName
    +string LastName
    +string Email
    +string Subject
    +string Message
    +DateTime CreatedAt
    +string Status
}

class ApplicationSettings {
    +int ApplicationSettingsId
    +string ContactEmail
}
