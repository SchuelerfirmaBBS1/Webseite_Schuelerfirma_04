classDiagram

class User {
    +int UserId
    +int RoleId
    +string Username
    +string Email
    +string PasswordHash
    +bool IsActive
    +int FailedLoginCount
    +DateTime? LockoutEnd
    +bool MustChangePassword
    +DateTime CreatedAt
    +DateTime? LastLoginAt
}

class Role {
    +int RoleId
    +string Name
}

class UserSession {
    +string SessionKeyHash
    +int UserId
    +byte[] Ticket
    +DateTime CreatedAt
    +DateTime ExpiresAt
}

Role "1" --> "*" User
User "1" --> "*" UserSession

class Category {
    +int CategoryId
    +string Name
    +bool IsVisible
}

class Product {
    +int ProductId
    +int CategoryId
    +string Name
    +string? Description
    +decimal? Price
    +bool IsActive
}

class ProductImage {
    +int ProductImageId
    +int ProductId
    +string FileName
    +string? Description
    +string ContentType
    +string FilePath
    +int SortOrder
    +bool IsPrimary
}

Category "1" --> "*" Product
Product "1" --> "*" ProductImage

class Event {
    +int EventId
    +string Name
    +string? Description
    +string Location
    +DateTime StartDateTime
    +DateTime? EndDateTime
}

class EventImage {
    +int EventImageId
    +int EventId
    +string FileName
    +string? Description
    +string ContentType
    +string FilePath
    +int SortOrder
}

Event "1" --> "*" EventImage

class ContactRequest {
    +int ContactRequestId
    +string FirstName
    +string LastName
    +string Email
    +string Subject
    +string Message
    +DateTime CreatedAt
    +string Status
}

class ApplicationSettings {
