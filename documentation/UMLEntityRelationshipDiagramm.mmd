erDiagram

    USERS {
        int UserId PK
        int RoleId FK
        string Username
        string Email
        string PasswordHash
        bool IsActive
        int FailedLoginCount
        datetime? LockoutEnd
        bool MustChangePassword
        datetime CreatedAt
        datetime? LastLoginAt
    }

    ROLES {
        int RoleId PK
        string Name
    }

    USER_SESSIONS {
        string SessionKeyHash PK
        int UserId FK
        byte[] Ticket
        datetime CreatedAt
        datetime ExpiresAt
    }

    CATEGORIES {
        int CategoryId PK
        string Name
        bool IsVisible
    }

    PRODUCTS {
        int ProductId PK
        int CategoryId FK
        string Name
        string? Description
        decimal? Price
        bool IsPriceVisible
        bool IsActive
    }

    EVENTS {
        int EventId PK
        string Name
        string? Description
        string Location
        datetime StartDateTime
        datetime? EndDateTime
    }

    %% Owners point to their images through an assignment table; IMAGES knows no owner.
    %% EVENT_IMAGES comes with the events (#14).
    IMAGES {
        int ImageId PK
        string FileName
        string? Description
        string ContentType
        long Length
    }

    PRODUCT_IMAGES {
        int ImageId PK, FK
        int ProductId FK
        int SortOrder
        bool IsPrimary
    }

    EVENT_IMAGES {
        int ImageId PK, FK
        int EventId FK
        int SortOrder
        bool IsPrimary
    }

    IMAGE_CONTENTS {
        int ImageId PK, FK
        byte[] Data
    }

    CONTACT_REQUESTS {
        int ContactRequestId PK
        string FirstName
        string LastName
        string Email
        string Subject
        string Message
        datetime CreatedAt
        string Status
    }

    APPLICATION_SETTINGS {
        int ApplicationSettingsId PK
        string ContactEmail
    }

    CATEGORIES ||--o{ PRODUCTS : contains
    PRODUCTS ||--o{ PRODUCT_IMAGES : has
    PRODUCT_IMAGES |o--|| IMAGES : assigns
    EVENTS ||--o{ EVENT_IMAGES : has
    EVENT_IMAGES |o--|| IMAGES : assigns
    IMAGES ||--|| IMAGE_CONTENTS : stores

    ROLES ||--o{ USERS : assigned_to
    USERS ||--o{ USER_SESSIONS : has
