erDiagram

    USERS {
        int UserId PK
        int RoleId FK
        string Username
        string Email
        string PasswordHash
        bool IsActive
        int FailedLoginCount
        datetime? LockoutEnd
        bool MustChangePassword
        datetime CreatedAt
        datetime? LastLoginAt
    }

    ROLES {
        int RoleId PK
        string Name
    }

    USER_SESSIONS {
        string SessionKeyHash PK
        int UserId FK
        byte[] Ticket
        datetime CreatedAt
        datetime ExpiresAt
    }

    CATEGORIES {
        int CategoryId PK
        string Name
        bool IsVisible
    }

    PRODUCTS {
        int ProductId PK
        int CategoryId FK
        string Name
        string? Description
        decimal? Price
        bool IsPriceVisible
        bool IsActive
    }

    EVENTS {
        int EventId PK
        string Name
        string? Description
        string Location
        datetime StartDateTime
        datetime? EndDateTime
    }

    %% One image table for all owners: exactly one of ProductId / EventId is set (CK_Images_ExactlyOneOwner).
    %% EventId comes with the events (#14).
    IMAGES {
        int ImageId PK
        int? ProductId FK
        int? EventId FK
        string FileName
        string? Description
        string ContentType
        long Length
        int SortOrder
        bool IsPrimary
    }

    IMAGE_CONTENTS {
        int ImageId PK, FK
        byte[] Data
    }

    CONTACT_REQUESTS {
        int ContactRequestId PK
        string FirstName
        string LastName
        string Email
        string Subject
        string Message
        datetime CreatedAt
        string Status
    }

    APPLICATION_SETTINGS {
        int ApplicationSettingsId PK
        string ContactEmail
    }

    CATEGORIES ||--o{ PRODUCTS : contains
    PRODUCTS |o--o{ IMAGES : has
    EVENTS |o--o{ IMAGES : has
    IMAGES ||--|| IMAGE_CONTENTS : stores

    ROLES ||--o{ USERS : assigned_to
    USERS ||--o{ USER_SESSIONS : has
