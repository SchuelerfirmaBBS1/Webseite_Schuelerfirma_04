{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Auth": {
    "Password": {
      "MinLength": 12
    }
  },
  "Authorization": {
    "RolePermissions": {
      "Admin": [ "*" ],
      "User": [ "events.create", "events.update", "images.upload", "products.read", "products.toggle-price-visibility" ]
    }
  },
  "ForwardedHeaders": {
    "KnownProxies": []
  }
}
