# Reverse proxy for the Schuelerfirma website. Mounted read-only by deploy/compose.yaml.
# Values in {$...} come from the proxy's environment (deploy/.env).
{
	# No admin API: configuration changes need "docker compose restart proxy".
	admin off
}

# A domain name gets a certificate automatically, HTTP is redirected to HTTPS.
{$SITE_ADDRESS} {
	# Upper limit for request bodies; keep it at least as large as the upload limit of #13.
	request_body {
		max_size {$MAX_REQUEST_BODY}
	}

	# API. Caddy sets X-Forwarded-For/-Proto itself and, without "trusted_proxies", discards the
	# values a client sends, so nobody can spoof their IP towards the API (rate limiting).
	# No caching here: /api/admin and /api/auth must never be cached.
	handle /api/* {
		reverse_proxy api:8080
	}

	# Everything else: the Vue build, with index.html as fallback for client-side routes.
	# Compression only for these static files, not for API responses (they may carry tokens).
	handle {
		root * /srv
		encode zstd gzip
		try_files {path} /index.html

		header {
			X-Content-Type-Options "nosniff"
			Referrer-Policy "no-referrer"
			Content-Security-Policy "frame-ancestors 'none'"
		}

		# Vite puts a content hash into every file name under /assets/, so they can be cached forever.
		# index.html and the rest are revalidated on every load, so a new release shows up immediately.
		@assets path /assets/*
		@notAssets not path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		header @notAssets Cache-Control "no-cache"

		file_server
	}

	header -Server
}
