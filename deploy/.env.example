# Template for deploy/.env (never commit the real file, it is in .gitignore):
#   cp deploy/.env.example deploy/.env && chmod 600 deploy/.env
# Values containing "$" must be wrapped in single quotes, otherwise compose expands them.

# Domain of the website. Caddy fetches the certificate for it automatically (DNS must point to the
# server, ports 80 and 443 must be reachable). "localhost" uses Caddy's internal CA for local tests.
SITE_ADDRESS=schuelerfirma.example.org

# Database. Generate passwords with: openssl rand -hex 24  (no ";", it would break the connection string)
MYSQL_DATABASE=schuelerfirma
MYSQL_USER=schuelerfirma_app
MYSQL_PASSWORD=change-me-db-password
MYSQL_ROOT_PASSWORD=change-me-db-root-password

# First administrator, created on start if no active admin exists. The password must satisfy the
# password policy (min. 12 characters, upper/lower case, digit, special character) and must be
# changed at the first login. Remove BOOTSTRAP_ADMIN_PASSWORD afterwards and run "docker compose up -d".
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_EMAIL=admin@example.org
BOOTSTRAP_ADMIN_PASSWORD=

# Maximum request body accepted by the proxy (Caddy size, MB = 1,000,000 bytes). Keep it a little above the
# API's upload limit Images:MaxRequestSizeBytes (default 30 MiB = 31.5 MB), which also counts the multipart framing.
MAX_REQUEST_BODY=32MB

# Network between proxy and API. Only change it if the subnet collides with an existing network on
# the server. PROXY_IP must lie inside EDGE_SUBNET but outside EDGE_DYNAMIC_RANGE (the range the
# other containers get their addresses from). The API trusts X-Forwarded-For only from PROXY_IP.
EDGE_SUBNET=172.30.43.0/24
EDGE_DYNAMIC_RANGE=172.30.43.128/25
PROXY_IP=172.30.43.2
